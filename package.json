{
  "name": "oxsig",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node server.mjs --dev",
    "dev:up": "bash scripts/dev-up.sh",
    "build": "next build && node scripts/verify-built-routes.mjs",
    "start": "node scripts/start-production.mjs --prod",
    "server:check": "node --check server.mjs && node --check scripts/start-production.mjs && node --check scripts/env-loader.mjs && node --check scripts/env-reconcile-lib.mjs && node --check scripts/env-reconcile.mjs && node --check scripts/env-contract-check.mjs && node --check scripts/elevenlabs-voices-lib.mjs && node --check scripts/elevenlabs-voices.mjs && node --check scripts/schema-parity-lib.mjs && node --check scripts/schema-parity-check.mjs",
    "env:reconcile": "node scripts/env-reconcile.mjs",
    "env:check": "node scripts/env-reconcile.mjs --check",
    "env:contract": "node scripts/env-contract-check.mjs",
    "prod:check": "node scripts/production-check-runner.mjs",
    "readiness": "node scripts/readiness-check.mjs",
    "elevenlabs:voices": "node scripts/elevenlabs-voices.mjs",
    "typecheck": "tsc --noEmit",
    "audit:reachability": "node scripts/source-reachability-audit.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "node scripts/migrate.mjs",
    "db:parity": "node scripts/schema-parity-check.mjs",
    "storyboards:migrate-audio": "node scripts/migrate-storyboard-audio.mjs"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-ec2": "^3.913.0",
    "@aws-sdk/client-s3": "^3.732.0",
    "@aws-sdk/client-ssm": "^3.913.0",
    "@aws-sdk/s3-presigned-post": "^3.913.0",
    "@aws-sdk/s3-request-presigner": "^3.913.0",
    "@clerk/nextjs": "^7.8.4",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@sentry/nextjs": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.3",
    "@vercel/functions": "^3.9.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.5",
    "ably": "^2.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.511.0",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "posthog-node": "^5.51.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "uuid": "^11.0.5",
    "ws": "^8.18.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "4.0.4",
    "happy-dom": "^20.0.8",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "4.0.4"
  }
}

