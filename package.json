{
  "name": "@oxsig/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "OxSig - Quantum-Safe Security Platform (CISA/CISM/CISSP/CEH Portfolio)",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @oxsig/frontend dev",
    "dev:frontend": "pnpm --filter @oxsig/frontend dev",
    "dev:backend": "pnpm --filter @oxsig/backend-ws dev",
    "build": "pnpm -r build",
    "build:frontend": "pnpm --filter @oxsig/frontend build",
    "build:backend": "pnpm --filter @oxsig/backend-ws build",
    "start": "pnpm --filter @oxsig/frontend start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "docker:build": "docker compose -f infrastructure/docker/docker-compose.yml build",
    "docker:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "docker:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "docker:ps": "docker compose -f infrastructure/docker/docker-compose.yml ps",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "keywords": [
    "security",
    "cryptography",
    "post-quantum",
    "zero-knowledge",
    "CISA",
    "CISM",
    "CISSP",
    "CEH",
    "portfolio"
  ],
  "author": "jbblay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbblay/oxsig.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prettier": "^3.0.0",
    "typescript": "^5"
  }
}
