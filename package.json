{
  "name": "@oxsig/frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run && pnpm build",
    "setup": "node scripts/setup-env.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "services:up": "docker compose --env-file .env.local up -d --wait postgres minio && docker compose --env-file .env.local run --rm minio-init",
    "services:down": "docker compose --env-file .env.local down",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@noble/ed25519": "^3.0.0",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.24",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.11.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.0.4",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.24",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5",
    "vitest": "^4.0.4"
  },
  "knip": {
    "ignoreDependencies": ["eslint-config-next"]
  }
}
