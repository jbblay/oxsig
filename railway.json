{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --filter=@oxsig/frontend --frozen-lockfile && pnpm --filter=@oxsig/frontend build",
    "watchPatterns": [
      "packages/frontend/**"
    ]
  },
  "deploy": {
    "startCommand": "cd packages/frontend && pnpm start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "sleepApplication": false
  },
  "environments": {
    "production": {
      "build": {
        "buildCommand": "pnpm install --filter=@oxsig/frontend --frozen-lockfile && pnpm --filter=@oxsig/frontend build"
      }
    }
  }
}
