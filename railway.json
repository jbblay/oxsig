{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd packages/frontend && pnpm install && pnpm build",
    "watchPatterns": [
      "packages/frontend/**"
    ]
  },
  "deploy": {
    "startCommand": "cd packages/frontend && pnpm start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
