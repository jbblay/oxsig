# Frontend-only Dockerfile for deployment
FROM node:18-alpine AS base

# Install pnpm
RUN npm install -g pnpm

# Set working directory
WORKDIR /app

# Copy workspace config
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./

# Copy frontend package
COPY packages/frontend ./packages/frontend

# Install dependencies (frontend only)
RUN pnpm install --filter=@oxsig/frontend --frozen-lockfile

# Build frontend
RUN pnpm --filter=@oxsig/frontend build

# Production stage
FROM node:18-alpine AS runner

# Install pnpm
RUN npm install -g pnpm

WORKDIR /app

# Copy built assets
COPY --from=base /app/packages/frontend/.next ./packages/frontend/.next
COPY --from=base /app/packages/frontend/public ./packages/frontend/public
COPY --from=base /app/packages/frontend/package.json ./packages/frontend/package.json
COPY --from=base /app/packages/frontend/next.config.ts ./packages/frontend/next.config.ts
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=base /app/package.json ./package.json

# Set environment
ENV NODE_ENV=production
ENV PORT=3000

# Expose port
EXPOSE 3000

# Start Next.js
CMD ["pnpm", "--filter=@oxsig/frontend", "start"]
