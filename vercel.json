{
  "buildCommand": "cd packages/frontend && pnpm install && pnpm build",
  "outputDirectory": "packages/frontend/.next",
  "devCommand": "cd packages/frontend && pnpm dev",
  "installCommand": "pnpm install --filter=@oxsig/frontend",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "feat/monorepo-structure": true
    }
  }
}
