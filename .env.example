# ============================================================================
# APPLICATION ENVIRONMENT CONTRACT (.env.example)
# ============================================================================

# USER LOGIN AND ACCOUNTS (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# MAIN DATABASE (Neon Postgres)
DATABASE_URL=

# WEBSITE LINKS AND CORS DOMAINS
OXSIG_APP_URL=
ALLOWED_ORIGINS=
OXSIG_HOST=
OXSIG_APP_HOST=

# EMAIL ENGINE (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# LIVE MULTIPLAYER CHAT AND SYNC (Ably)
ABLY_API_KEY=
COLLAB_MAX_ATTACHMENT_BYTES=31457280

# FILE UPLOADS AND STORAGE LIMITS
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_MAX_UPLOAD_BYTES=104857600
STORAGE_MAX_SERVER_UPLOAD_BYTES=104857600
STORYBOARD_MAX_AUDIO_BYTES=52428800

# ARTIFICIAL INTELLIGENCE (provider-independent Oxsig AI + ElevenLabs voice)
# openai is the first provider adapter; additional providers plug into the same server contract.
OXSIG_AI_PROVIDER=openai
OPENAI_API_KEY=
OXSIG_AI_MODEL=gpt-5.4-mini
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=

# AWS CLOUD VIRTUAL MACHINE SYSTEM
AWS_ROLE_ARN=
LAB_AWS_ENABLED=true
LAB_AWS_REGION=eu-central-1
LAB_AWS_SUBNET_ID=
LAB_AWS_SECURITY_GROUP_ID=
LAB_AWS_TTL_MINUTES=60
LAB_AWS_INSTANCE_PROFILE=oxsig-lab-ssm-role

# PREPARED BLACK DOMAIN (production reusable environment)
# When true, Black Domain starts the existing reusable Slot 01 machines.
# When false or missing, Black Domain fails closed and does not create disposable fallback instances.
LAB_AWS_BLACK_DOMAIN_PREPARED=false
LAB_AWS_BLACK_DOMAIN_SLOT_KEY=black-domain-slot-01
LAB_AWS_BLACK_DOMAIN_DC_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_WORKSTATION_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_OPERATOR_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_DC_SNAPSHOT_ID=
LAB_AWS_BLACK_DOMAIN_WORKSTATION_SNAPSHOT_ID=
LAB_AWS_BLACK_DOMAIN_OPERATOR_SNAPSHOT_ID=
# Secret: configure only in the deployment environment. Never commit a value.
LAB_AWS_BLACK_DOMAIN_INITIAL_PASSWORD=

# AWS OPERATING SYSTEM IMAGES (AMIs)
LAB_AWS_AMI_ID=
LAB_AWS_UBUNTU_AMI_ID=
LAB_AWS_AMAZON_LINUX_AMI_ID=
LAB_AWS_ROCKY_AMI_ID=
LAB_AWS_KALI_AMI_ID=
LAB_AWS_WINDOWS_AMI_ID=

# AWS VIRTUAL MACHINE SIZES (ordinary disposable Cyber Labs)
LAB_AWS_INSTANCE_TYPE=t3.micro
LAB_AWS_WINDOWS_INSTANCE_TYPE=t3.small
LAB_AWS_UBUNTU_INSTANCE_TYPE=t3.micro
LAB_AWS_AMAZON_LINUX_INSTANCE_TYPE=t3.micro
LAB_AWS_ROCKY_INSTANCE_TYPE=t3.micro
LAB_AWS_KALI_INSTANCE_TYPE=t3.micro

# BUG AND CRASH TRACKING (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# USER TRACKING AND METRICS (PostHog Analytics)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://posthog.com

# SECURITY KEYS AND AUTOMATIC BACKGROUND TASKS
CRON_SECRET=
OXSIG_TERMINAL_BRIDGE_SECRET=

# LOCAL DEVELOPMENT AND TEST ONLY
# These keys must never be copied to production.
OXSIG_TEST_RESET_ENABLED=false
AWS_PROFILE=

# LEGACY DISPOSABLE BLACK DOMAIN TEST PATH ONLY
# The production runtime cannot dispatch this path. Keep these documented only so
# the environment-contract audit can account for legacy source references.
LAB_AWS_OPERATION_SECURITY_GROUP_ID=
LAB_AWS_OPERATION_PUBLIC_IP=true
LAB_AWS_OPERATION_LINUX_INSTANCE_TYPE=t3.small
LAB_AWS_OPERATION_WINDOWS_INSTANCE_TYPE=t3.medium
