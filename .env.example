# OXSIG runtime configuration
# Copy to .env.local for local development. Do not commit real secrets.

# Clerk identity/session provider
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Clerk webhook signing secret for POST /api/webhooks/clerk.
CLERK_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_CLERK_WEBHOOK_SIGNING_SECRET

# Hosted PostgreSQL / Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Vercel's managed Neon integration may provide these automatically.
# DATABASE_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# DATABASE_POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Optional explicit SSL override.
# POSTGRES_SSL=require
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Transitional legacy JWT keys. Remove when legacy password/DID auth is removed.
JWT_PRIVATE_KEY=REPLACE_WITH_PKCS8_HEX
JWT_PUBLIC_KEY=REPLACE_WITH_SPKI_HEX

# AWS-backed Cyber Lab.
# AWS SDK credentials must be supplied securely by the deployment runtime.
# Prefer a dedicated least-privilege identity or workload federation; never use root credentials.
LAB_AWS_ENABLED=false
LAB_AWS_REGION=eu-central-1
LAB_AWS_SUBNET_ID=REPLACE_WITH_LAB_SUBNET_ID
LAB_AWS_SECURITY_GROUP_ID=REPLACE_WITH_LAB_SECURITY_GROUP_ID
LAB_AWS_INSTANCE_TYPE=t3.micro
LAB_AWS_TTL_MINUTES=60

# Optional: pin an Ubuntu AMI instead of resolving the newest Ubuntu 24.04 image.
# LAB_AWS_AMI_ID=ami-xxxxxxxxxxxxxxxxx

# Optional for SSM command/terminal support. The EC2 role must allow SSM managed-instance access.
# LAB_AWS_INSTANCE_PROFILE=OxsigLabInstanceRole
