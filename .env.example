# OXSIG runtime configuration
# Copy to .env.local for local development. Do not commit real secrets.

# Clerk identity/session provider
# Get these from the Clerk Dashboard -> API keys. Never commit real values.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_WITH_CLERK_SECRET_KEY

# Clerk-hosted flows rendered inside OxSig.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Clerk webhook signing secret for POST /api/webhooks/clerk.
# Subscribe the endpoint to user.created, user.updated, and user.deleted.
CLERK_WEBHOOK_SIGNING_SECRET=REPLACE_WITH_CLERK_WEBHOOK_SIGNING_SECRET

# Hosted PostgreSQL (recommended for Vercel / Neon)
# Most providers supply this complete URL. Include the provider's SSL options,
# for example ?sslmode=require, when required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Vercel's managed Neon integration provides these automatically. Do not add
# duplicates manually; OXSIG uses them when DATABASE_URL is absent.
# DATABASE_POSTGRES_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# DATABASE_POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require

# Optional explicit SSL override for providers that do not encode SSL in the URL.
# POSTGRES_SSL=require
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Legacy/local Docker PostgreSQL variables. DATABASE_URL takes precedence.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=oxsig
# POSTGRES_USER=oxsig
# POSTGRES_PASSWORD=change-me

# Transitional legacy Ed25519 JWT signing keys.
# Keep these while legacy password/DID sessions are accepted. Remove after the
# Clerk migration is complete. Generate locally with: pnpm auth:generate-keys
JWT_PRIVATE_KEY=REPLACE_WITH_PKCS8_HEX
JWT_PUBLIC_KEY=REPLACE_WITH_SPKI_HEX

# Optional self-hosted Cyber Labs runtime. Leave disabled on Vercel.
# LAB_DOCKER_ENABLED=true
# LAB_KALI_IMAGE=kalilinux/kali-rolling:latest
