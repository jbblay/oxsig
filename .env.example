# Oxsig environment contract
#
# Keep every application-owned environment variable documented here. Run
# `pnpm env:reconcile` to append only missing keys to .env.local and
# .env.production. Existing assignments and secret values are never overwritten
# or printed. Identity, database, public URL, cron, and terminal-bridge values
# are intentionally left blank in production until an explicit production value
# is supplied. Both real environment files remain gitignored.

# Clerk identity
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon PostgreSQL
DATABASE_URL=

# Public application URL used in transactional links.
# Example: https://oxsig.example.com
OXSIG_APP_URL=

# Transactional email (Resend).
# Optional until email-backed capabilities are enabled. When configured, use a
# verified sender such as: OXSIG <notifications@your-domain.com>
RESEND_API_KEY=
EMAIL_FROM=

# Realtime collaboration (Ably).
# Server-side only. Browser clients receive short-lived, collaboration-scoped
# tokens from OXSIG; never expose this API key through NEXT_PUBLIC_* variables.
ABLY_API_KEY=
# Optional per-collaboration attachment limit. Defaults to 30 MiB.
COLLAB_MAX_ATTACHMENT_BYTES=31457280

# Production observability (Sentry).
# Optional: OXSIG runs normally without these values. Configure SENTRY_DSN for
# server/custom-terminal errors and NEXT_PUBLIC_SENTRY_DSN for browser errors.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional source-map upload configuration used only during production builds.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Product analytics (PostHog).
# Optional and server-side by default. OXSIG captures only explicit allow-listed
# product events; it does not enable pageview/autocapture/session replay here.
POSTHOG_PROJECT_TOKEN=
# Examples: https://us.i.posthog.com or https://eu.i.posthog.com
POSTHOG_HOST=

# Scheduled maintenance endpoint authentication.
# The scheduler must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# AWS S3 storage
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_MAX_UPLOAD_BYTES=104857600
# Direct-to-S3 Storyboard recording limit. Defaults to 50 MiB and may not
# exceed the database contract ceiling of 512 MiB.
STORYBOARD_MAX_AUDIO_BYTES=52428800

# AWS Cyber Lab
LAB_AWS_ENABLED=false
LAB_AWS_REGION=eu-central-1
LAB_AWS_SUBNET_ID=
LAB_AWS_SECURITY_GROUP_ID=
# Required dedicated self-referencing security group for multi-node Operations.
# Do not reuse the ordinary Cyber Lab security group.
LAB_AWS_OPERATION_SECURITY_GROUP_ID=
LAB_AWS_TTL_MINUTES=60
LAB_AWS_INSTANCE_PROFILE=

# Default Linux VM size. Windows uses t3.small unless overridden below.
LAB_AWS_INSTANCE_TYPE=t3.micro
# LAB_AWS_WINDOWS_INSTANCE_TYPE=t3.small

# Optional AMI overrides. When omitted, Oxsig resolves the latest matching image
# in LAB_AWS_REGION for Ubuntu 24.04, Amazon Linux 2023, Rocky Linux 9,
# Kali Linux, and Windows Server 2022.
# LAB_AWS_AMI_ID=
# LAB_AWS_UBUNTU_AMI_ID=
# LAB_AWS_AMAZON_LINUX_AMI_ID=
# LAB_AWS_ROCKY_AMI_ID=
# LAB_AWS_KALI_AMI_ID=
# LAB_AWS_WINDOWS_AMI_ID=

# Optional per-OS instance-size overrides.
# LAB_AWS_UBUNTU_INSTANCE_TYPE=t3.micro
# LAB_AWS_AMAZON_LINUX_INSTANCE_TYPE=t3.micro
# LAB_AWS_ROCKY_INSTANCE_TYPE=t3.micro
# LAB_AWS_KALI_INSTANCE_TYPE=t3.micro
# LAB_AWS_WINDOWS_INSTANCE_TYPE=t3.small

# Terminal bridge security.
# Required in production. Generate a long random secret and keep the same value
# across every application instance so encrypted terminal tickets remain valid.
OXSIG_TERMINAL_BRIDGE_SECRET=

# AI Practitioner + Academy (server-side only; never expose this key to the browser).
OPENAI_API_KEY=
# Optional model override. The default is gpt-5.4-mini.
# OXSIG_AI_MODEL=gpt-5.4-mini

# ElevenLabs Academy voice layer (server-side only; never use NEXT_PUBLIC_*).
ELEVENLABS_API_KEY=
# Run `pnpm elevenlabs:voices` to list voices available to the configured account,
# then store the chosen instructor voice ID here.
ELEVENLABS_VOICE_ID=
# Optional TTS model override. Defaults to eleven_multilingual_v2.
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# Optional STT model override. Defaults to scribe_v2.
# ELEVENLABS_STT_MODEL=scribe_v2

# Local development only. Do not copy AWS_PROFILE to production hosting.
# The deployed application should use an AWS IAM/OIDC role.
AWS_PROFILE=
