# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oxsig
POSTGRES_USER=oxsig
POSTGRES_PASSWORD=oxsig_secure_password

# MinIO (private S3-compatible document storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=oxsig-documents

# Ed25519 JWT keys, encoded as PKCS#8/SPKI DER hex.
# Run `pnpm setup` to generate these safely in .env.local.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
