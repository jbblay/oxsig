# ============================================================================
# APPLICATION ENVIRONMENT CONTRACT (.env.example)
# ============================================================================

# USER LOGIN AND ACCOUNTS (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Comma-separated founder emails. A matching Clerk-verified email is a platform admin.
OXSIG_FOUNDER_EMAILS=

# MAIN DATABASE (Neon Postgres)
DATABASE_URL=

# WEBSITE LINKS AND CORS DOMAINS
# OXSIG_APP_URL is also an authorized Clerk party, so sessions keep working
# behind TLS-terminating load balancers (AWS ALB/CloudFront).
OXSIG_APP_URL=
ALLOWED_ORIGINS=
OXSIG_HOST=
OXSIG_APP_HOST=

# EMAIL ENGINE (provider-independent: resend | ses; default resend)
OXSIG_EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Amazon SES v2 (used when OXSIG_EMAIL_PROVIDER=ses; EMAIL_FROM must be a verified identity)
SES_REGION=
SES_CONFIGURATION_SET=

# LIVE MULTIPLAYER CHAT AND SYNC (Ably)
ABLY_API_KEY=
COLLAB_MAX_ATTACHMENT_BYTES=31457280

# FILE UPLOADS AND STORAGE LIMITS
STORAGE_BUCKET=
STORAGE_REGION=eu-central-1
STORAGE_MAX_UPLOAD_BYTES=104857600
STORAGE_MAX_SERVER_UPLOAD_BYTES=104857600
STORYBOARD_MAX_AUDIO_BYTES=52428800

# ARTIFICIAL INTELLIGENCE (provider-independent Oxsig AI + ElevenLabs voice)
# openai is the first provider adapter; additional providers plug into the same server contract.
OXSIG_AI_PROVIDER=openai
# Optional secondary provider used when the primary fails (incremental cutover / rollback).
OXSIG_AI_FALLBACK_PROVIDER=
OPENAI_API_KEY=
OXSIG_AI_MODEL=gpt-5.4-mini
# Amazon Bedrock (OXSIG_AI_PROVIDER=bedrock): model or inference-profile id enabled in the account.
OXSIG_BEDROCK_MODEL_ID=
OXSIG_BEDROCK_REGION=
# VOICE OUTPUT (AWS Polly is an optional TTS provider; default remains ElevenLabs)
# Set OXSIG_VOICE_TTS_PROVIDER=polly after AWS IAM and voice quality verification.
# To keep a backup, set OXSIG_VOICE_TTS_FALLBACK_PROVIDER=polly or elevenlabs.
# Voice INPUT can opt into AWS Transcribe batch (requires a private S3 bucket, IAM,
# and a 1-day lifecycle expiry on voice-transcriptions/temporary/). Default unchanged.
OXSIG_VOICE_TTS_PROVIDER=elevenlabs
OXSIG_VOICE_TTS_FALLBACK_PROVIDER=
OXSIG_POLLY_REGION=eu-central-1
OXSIG_POLLY_VOICE_ID=Joanna
OXSIG_POLLY_ENGINE=neural
# VOICE INPUT: explicitly choose transcribe or leave the existing ElevenLabs default.
# AWS Transcribe batch is not a streaming STT engine; short clips can add latency.
OXSIG_VOICE_STT_PROVIDER=elevenlabs
OXSIG_VOICE_STT_FALLBACK_PROVIDER=
OXSIG_TRANSCRIBE_REGION=eu-central-1
# Optional override. Unset uses the existing private STORAGE_BUCKET.
OXSIG_TRANSCRIBE_STORAGE_BUCKET=
# Optional fixed language, e.g. en-US. Unset enables automatic language detection.
OXSIG_TRANSCRIBE_LANGUAGE_CODE=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=

# AWS CLOUD VIRTUAL MACHINE SYSTEM
AWS_ROLE_ARN=
LAB_AWS_ENABLED=true
LAB_AWS_REGION=eu-central-1
LAB_AWS_SUBNET_ID=
LAB_AWS_SECURITY_GROUP_ID=
LAB_AWS_TTL_MINUTES=60
LAB_AWS_INSTANCE_PROFILE=oxsig-lab-ssm-role

# PREPARED BLACK DOMAIN (production reusable environment)
# When true, Black Domain starts the existing reusable Slot 01 machines.
# When false or missing, Black Domain fails closed and does not create disposable fallback instances.
LAB_AWS_BLACK_DOMAIN_PREPARED=false
LAB_AWS_BLACK_DOMAIN_SLOT_KEY=black-domain-slot-01
LAB_AWS_BLACK_DOMAIN_DC_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_WORKSTATION_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_OPERATOR_INSTANCE_ID=
LAB_AWS_BLACK_DOMAIN_DC_SNAPSHOT_ID=
LAB_AWS_BLACK_DOMAIN_WORKSTATION_SNAPSHOT_ID=
LAB_AWS_BLACK_DOMAIN_OPERATOR_SNAPSHOT_ID=
# Secret: configure only in the deployment environment. Never commit a value.
LAB_AWS_BLACK_DOMAIN_INITIAL_PASSWORD=

# AWS OPERATING SYSTEM IMAGES (AMIs)
LAB_AWS_AMI_ID=
LAB_AWS_UBUNTU_AMI_ID=
LAB_AWS_AMAZON_LINUX_AMI_ID=
LAB_AWS_ROCKY_AMI_ID=
LAB_AWS_KALI_AMI_ID=
LAB_AWS_WINDOWS_AMI_ID=

# AWS VIRTUAL MACHINE SIZES (ordinary disposable Cyber Labs)
LAB_AWS_INSTANCE_TYPE=t3.micro
LAB_AWS_WINDOWS_INSTANCE_TYPE=t3.small
LAB_AWS_UBUNTU_INSTANCE_TYPE=t3.micro
LAB_AWS_AMAZON_LINUX_INSTANCE_TYPE=t3.micro
LAB_AWS_ROCKY_INSTANCE_TYPE=t3.micro
LAB_AWS_KALI_INSTANCE_TYPE=t3.micro

# BUG AND CRASH TRACKING (Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# USER TRACKING AND METRICS (PostHog Analytics)
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://posthog.com

# SECURITY KEYS AND AUTOMATIC BACKGROUND TASKS
CRON_SECRET=
OXSIG_TERMINAL_BRIDGE_SECRET=

# DEPLOYMENT ENVIRONMENT (provider-neutral; replaces reliance on VERCEL_ENV)
# production | preview | staging | development. Unset production builds are
# treated as production (fail closed). Required for non-production AWS stacks.
OXSIG_DEPLOY_ENV=

# LOCAL DEVELOPMENT AND TEST ONLY
# These keys must never be copied to production.
OXSIG_TEST_RESET_ENABLED=false
OXSIG_E2E_AUTH_ENABLED=false
AWS_PROFILE=
# Disposable database for `pnpm db:verify` (CI sets this in buildspec.yml).
OXSIG_CI_DATABASE_URL=
OXSIG_TEST_DATABASE_URL=

# DATABASE MIGRATION TOOLING ONLY (scripts/aws/db-compare.mjs; never set in the app runtime)
SOURCE_DATABASE_URL=
TARGET_DATABASE_URL=

# LEGACY DISPOSABLE BLACK DOMAIN TEST PATH ONLY
# The production runtime cannot dispatch this path. Keep these documented only so
# the environment-contract audit can account for legacy source references.
LAB_AWS_OPERATION_SECURITY_GROUP_ID=
LAB_AWS_OPERATION_PUBLIC_IP=true
LAB_AWS_OPERATION_LINUX_INSTANCE_TYPE=t3.small
LAB_AWS_OPERATION_WINDOWS_INSTANCE_TYPE=t3.medium