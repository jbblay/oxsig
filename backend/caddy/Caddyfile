# OxSig Caddyfile - Reverse Proxy Configuration

{
    # Global options
    admin off
    log {
        output file /var/log/caddy/access.log
        format json
    }
}

# Main application
:80 {
    # WebSocket gateway
    handle /ws* {
        reverse_proxy ws-gateway:8080
    }

    # API endpoints
    handle /api/* {
        reverse_proxy ws-gateway:8080
    }

    # Next.js application
    handle /* {
        reverse_proxy host.docker.internal:3000
    }

    # Health check
    handle /health {
        respond "OK" 200
    }

    # Logging
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
        }
        format json
    }
}

# Monitoring stack (development only)
:3001 {
    handle /* {
        reverse_proxy grafana:3000
    }
}

# Meilisearch
:7700 {
    handle /* {
        reverse_proxy meilisearch:7700
    }
}

# MinIO Console
:9001 {
    handle /* {
        reverse_proxy minio:9001
    }
}

